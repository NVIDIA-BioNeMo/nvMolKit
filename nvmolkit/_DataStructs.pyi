from typing import Any, Dict, Tuple

import numpy as np

from nvmolkit.types import AsyncGpuResult

def CrossTanimotoSimilarityRawBuffers(fp1: Dict, fp2: Dict, stream: int = 0) -> AsyncGpuResult: ...
def CrossTanimotoSimilarityCPURawBuffers(fp1: Dict, fp2: Dict, stream: int = 0) -> np.ndarray: ...
def CrossCosineSimilarityRawBuffers(fp1: Dict, fp2: Dict, stream: int = 0) -> AsyncGpuResult: ...
def CrossCosineSimilarityCPURawBuffers(fp1: Dict, fp2: Dict, stream: int = 0) -> np.ndarray: ...

class FingerprintSearchIndex:
    def __init__(self, bits: Dict, metric: str, stream: int = 0) -> None: ...
    def search(self, queries: Dict, k: int, threshold: float, prune: bool, stream: int = 0) -> Tuple[Any, Any]: ...
    def searchSelf(self, k: int, threshold: float, prune: bool, stream: int = 0) -> Tuple[Any, Any]: ...
    def size(self) -> int: ...
    def numWords(self) -> int: ...
