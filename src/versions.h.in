#ifndef NVMOLKIT_VERSIONS_H
#define NVMOLKIT_VERSIONS_H

#define RDKIT_VERSION_MAJOR @RDKit_VERSION_MAJOR@
#define RDKIT_VERSION_MINOR @RDKit_VERSION_MINOR@
#define RDKIT_VERSION_PATCH @RDKit_VERSION_PATCH@


// Account for API break adding d_structureFlags. Our GPU codepath always includes it, but
// for an earlier version we pass in 1.0 to not change results. The CPU API must be adapted here and in
// chiralty ETKDG code. This must be a preprocessor macro: it gates calls to the ChiralSet structureFlags
// constructor overload, which only exists on RDKit >= 2024.09, so the branch cannot be compiled on older
// versions. Consumers select the codepath with `#if RDKIT_NEW_FLAG_API`.
#define RDKIT_NEW_FLAG_API (RDKIT_VERSION_MAJOR > 2024 || (RDKIT_VERSION_MAJOR == 2024 && RDKIT_VERSION_MINOR >= 9))

// RDKit's all-in-one ETKDG coordinate refinement was released in 2026.03.4.
// Keep this as a preprocessor macro because EmbedParameters::useLegacyImplementation
// and CrystalFFDetails::forceConsts do not exist in older supported RDKit headers.
#define RDKIT_AIO_ETKDG_API                                                                                       \
  (RDKIT_VERSION_MAJOR > 2026 ||                                                                                  \
   (RDKIT_VERSION_MAJOR == 2026 &&                                                                                \
    (RDKIT_VERSION_MINOR > 3 || (RDKIT_VERSION_MINOR == 3 && RDKIT_VERSION_PATCH >= 4))))

// RDKit 2026.09 sets topology bounds before the ETKDG torsions, records forced amide/ester 1-4 configurations that
// become torsion terms, keeps at most one experimental torsion per central bond, and adds the initialEmbeddingMode,
// onlyInitialEmbedding and embedForceField parameters. Preprocessor macro because those members do not exist in older
// supported RDKit headers.
#define RDKIT_ETKDG_2026_09_API (RDKIT_VERSION_MAJOR > 2026 || (RDKIT_VERSION_MAJOR == 2026 && RDKIT_VERSION_MINOR >= 9))

#endif  // NVMOLKIT_VERSIONS_H